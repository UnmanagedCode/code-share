{
  "id": "code-share",
  "name": "Code Share",
  "version": "1.0.0",
  "pluginApi": 1,
  "backend": {
    "start": "node bin/code-share.js serve",
    "healthPath": "/api/health"
  },
  "frontend": {
    "path": "/",
    "navLabel": "Code Share"
  },
  "mcp": {
    "endpoint": "/api/mcp",
    "timeoutMs": 30000,
    "tools": [
      {
        "name": "status",
        "description": "This code-share instance's URLs, ports, tunnel state, shared projects with their wired peers, and connected peers.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "uiPort",
            "tunnel",
            "tunnelStarting",
            "projectsRoot",
            "shared",
            "peers"
          ],
          "properties": {
            "selfUrl": {
              "type": [
                "string",
                "null"
              ],
              "description": "LAN base URL of the git server as stored; carries this instance's token as URL credentials. Null until serve has run."
            },
            "tunnelUrl": {
              "type": [
                "string",
                "null"
              ],
              "description": "Public tunnel URL as stored; carries this instance's token as URL credentials. Null when no tunnel is running."
            },
            "port": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "Git server port as stored."
            },
            "uiPort": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "description": "Persisted web UI port (a conductor launch may use $PORT instead)."
            },
            "tunnel": {
              "type": [
                "string",
                "null"
              ],
              "description": "Persisted default tunnel type."
            },
            "tunnelStarting": {
              "type": "boolean"
            },
            "projectsRoot": {
              "type": "string"
            },
            "shared": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "path",
                  "leader",
                  "peers"
                ],
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "leader": {
                    "type": "boolean",
                    "description": "This side's leader flag for the project."
                  },
                  "peers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "leader"
                      ],
                      "properties": {
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Peer base URL as stored; may carry the peer's token as URL credentials."
                        },
                        "token": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "The peer's token."
                        },
                        "leader": {
                          "type": "boolean",
                          "description": "The peer's last-known leader flag; false when never recorded."
                        }
                      }
                    }
                  }
                }
              }
            },
            "peers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Peer base URL as stored; may carry the peer's token as URL credentials."
                  },
                  "token": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The peer's token."
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "share",
        "description": "Add a local git repo to the shared scope so peers can fetch it read-only, wiring a git remote for every connected peer.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "repoPath": {
              "type": "string",
              "description": "Filesystem path to the git repo to share (absolute; a relative path resolves against the code-share backend's working directory)"
            },
            "name": {
              "type": "string",
              "description": "Name to serve the repo under (default: directory basename)"
            },
            "leader": {
              "type": "boolean",
              "description": "Mark this side as leader for this project (default false)"
            }
          },
          "required": [
            "repoPath"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "path",
            "leader",
            "wiredPeers",
            "skippedPeers"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "leader": {
              "type": "boolean"
            },
            "wiredPeers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Connected peers whose git remote was wired onto the project."
            },
            "skippedPeers": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": "Stored peer entries skipped as unusable (invalid name or URL); null for a non-string name."
            }
          }
        }
      },
      {
        "name": "sync",
        "description": "Pull-only sync of a shared project from a connected peer (never pushes): fetch, merge or rebase as the leader flags dictate, and the resulting ahead/behind state.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "description": "Project name to sync (omit if exactly one project is shared)"
            },
            "remote": {
              "type": "string",
              "description": "Peer remote name (default: peer)"
            },
            "branch": {
              "type": "string",
              "description": "Remote branch to fetch (default: HEAD)"
            },
            "useRebase": {
              "type": "boolean",
              "description": "Use rebase instead of merge (default false)"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "remote",
            "mode",
            "ahead",
            "behind",
            "state"
          ],
          "properties": {
            "project": {
              "type": "string"
            },
            "remote": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "rebase",
                "fast-forward",
                "follower-rebase",
                "symmetric-merge",
                "leader-ingest"
              ]
            },
            "ahead": {
              "type": "integer"
            },
            "behind": {
              "type": "integer"
            },
            "state": {
              "type": "string",
              "enum": [
                "in-sync",
                "local-ahead",
                "remote-ahead",
                "diverged"
              ]
            }
          }
        }
      }
    ]
  }
}
