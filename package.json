{
  "name": "code-share",
  "version": "1.0.0",
  "description": "Peer-to-peer read-only Git repo sharing over LAN or internet",
  "bin": {
    "code-share": "./bin/code-share.js"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 'tests/*.test.mjs' && npm run typecheck && npm run test:web",
    "prepare": "vite build --config frontend/vite.config.mts",
    "dev": "vite --config frontend/vite.config.mts",
    "typecheck": "tsc -p frontend",
    "test:web": "vitest run --config frontend/vitest.config.mts"
  },
  "dependencies": {
    "bonjour-service": "^1.4.0",
    "commander": "^15.0.0",
    "localtunnel": "^2.0.2",
    "node-git-server": "^1.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.14.6",
    "lucide-react": "^1.57.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true
}
